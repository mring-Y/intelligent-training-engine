ARG ITE_BASE_IMAGE=ite-ac-policy:20261115-v1
ARG ITE_BASE_IMAGE_ID=sha256:03a82fb40332b2e4ae96d3e1c2ee9b4a69ff41e2ee7e05fd2e8aaee91d06cfad
FROM ${ITE_BASE_IMAGE}
ARG ITE_BASE_IMAGE_ID
ARG ITE_SOURCE_COMMIT
ARG ITE_SOURCE_SHA256
ARG ITE_SOURCE_DIRTY=false
ENV ITE_SOURCE_COMMIT=${ITE_SOURCE_COMMIT} ITE_SOURCE_SHA256=${ITE_SOURCE_SHA256} ITE_SOURCE_DIRTY=${ITE_SOURCE_DIRTY} \
    ITE_OFFICIAL_RUNTIME_PYTHON=/opt/ite-official-a/bin/python \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 NUMEXPR_NUM_THREADS=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONUTF8=1 CONTEST_SUBMISSION=contest_submission
LABEL org.opencontainers.image.revision=${ITE_SOURCE_COMMIT} \
      org.ite.base.image.id=${ITE_BASE_IMAGE_ID} \
      org.ite.source.sha256=${ITE_SOURCE_SHA256} \
      org.ite.source.dirty=${ITE_SOURCE_DIRTY} \
      org.ite.default-entrypoint="official-workspace-v2" \
      org.ite.invocation-contract="/app/configs/contest-contract.json" \
      org.ite.platform-startup-contract="contest.harness.workspace.v2" \
      org.ite.model-access="host_gateway_rpc" \
      org.ite.official-sdk="1.0.2"
WORKDIR /app
COPY ite ./ite
COPY scripts ./scripts
COPY tests ./tests
COPY configs ./configs
COPY third_party/contest-harness-sdk-1.0.2/contest_harness ./third_party/contest-harness-sdk-1.0.2/contest_harness
COPY third_party/contest-harness-sdk-1.0.2/pyproject.toml ./third_party/contest-harness-sdk-1.0.2/pyproject.toml
COPY third_party/contest-harness-sdk-1.0.2-source.json ./third_party/
COPY third_party/official_baselines ./third_party/official_baselines
COPY harness.py contest_submission.py train.py predict.py pyproject.toml ./
RUN python -m pip install --no-deps --no-index --no-build-isolation --no-cache-dir /app/third_party/contest-harness-sdk-1.0.2
RUN python -c "from ite.tracking import source_metadata; source_metadata()"
ENTRYPOINT ["python3", "/app/harness.py"]
CMD ["describe"]
